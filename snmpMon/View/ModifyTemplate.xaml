<Window x:Class="snmpMon.View.ModifyTemplate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:snmpMon.View"
        xmlns:ctrl="clr-namespace:snmpMon.Resources.Constrols.InputControls.ConfigurationInputs"
        mc:Ignorable="d"
        Title="Modify Template" Height="510" Width="450" Background="#1F1D1D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Modify Template" FontSize="17" FontFamily="{StaticResource Google_Sans}" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/>
        <Border Grid.Row="1" Background="White" Opacity="0.6" Height="1"/>
        <ctrl:TemplateInformation Margin="5" Grid.Row="2" TemplateNameIsReadOnly="True" TemplateName="{Binding Node.Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  Vendor="{Binding Node.Vendor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  MemoryUsage="{Binding Node.Resources.MemoryConfig.MemoryUsageOID, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  CPUUsage="{Binding Node.Resources.CpuUsage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  DeviceTemperature="{Binding Node.Resources.DeviceTemperature, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  ConfirmCommand="{Binding ModifyCommand}"
                                  CommandPar="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
</Window>
