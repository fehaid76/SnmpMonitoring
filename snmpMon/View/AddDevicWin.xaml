<Window x:Class="snmpMon.View.AddDevicWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:snmpMon.View"
        xmlns:ctrl="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
        mc:Ignorable="d"
        Title="AddDevicWin" Height="330" Width="400" MaxHeight="500" MaxWidth="500"
        MinHeight="330" MinWidth="400" WindowStartupLocation="CenterScreen"  WindowStyle="None" MouseDown="Window_MouseDown"  Background="#292629">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="2" Height="18" Width="18" Style="{StaticResource Close_Button}" Command="{Binding CloseCMD}" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="5"/>
        </Grid>
        <Line Stroke="White" StrokeThickness="0.5" Grid.Row="1" Width="500" Height="0.5" X1="500"/>
        <ctrl:Information 
            Title="This Box for information about this service!"
            Image="/Resources/Imgs/Information.png" Grid.Row="2"/>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="10">
            <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBox_Style}"
                     Tag="Device name" Height="45" Width="350"
                     FontFamily="{StaticResource Hacen_Font}"
                     FontSize="13"/>

            <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource TextBox_Style}"
                Tag="IP Address" Height="45"
                Width="350" FontFamily="{StaticResource Hacen_Font}"
                FontSize="13"/>

            <TextBox Text="{Binding ComString, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource TextBox_Style}" 
                Tag="Community string" Height="48"
                Width="350" FontFamily="{StaticResource Hacen_Font}"
                FontSize="13"/>
            
        </StackPanel>
        <Button Grid.Row="4" Height="30" Width="110"
                Content="Add"
                Style="{StaticResource Button_Modern}"
                Tag="/Resources/Imgs/Add.png"
                Command="{Binding AddCMD}"/>
        
    </Grid>
</Window>
