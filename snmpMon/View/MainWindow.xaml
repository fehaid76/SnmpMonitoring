<Window x:Class="snmpMon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:snmpMon"
        xmlns:ctrl="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="850"  MinHeight="600" MinWidth="950" WindowStartupLocation="CenterScreen"  Background="#242124">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Logo" SnapsToDevicePixels="True" CornerRadius="7" BorderThickness="0" Padding="4" Grid.Column="0" Margin="5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#e0e1dd" Offset="0.0"/>
                        <GradientStop Color="#adb5bd" Offset="1.0"/>
                    </LinearGradientBrush> 
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Resources/Imgs/Logo.png" Grid.Column="0" RenderOptions.BitmapScalingMode="HighQuality" Height="26" Width="26"/>
                    <TextBlock Text="SNMP Monitor" FontFamily="{StaticResource Wafeq_Font}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="3" Grid.Column="1">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#415a77" Offset="0.0"/>
                                <GradientStop Color="#1b263b" Offset="1.1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground> 
                    </TextBlock>
                </Grid>
                
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#1A1110" BorderThickness="1" Grid.Column="1">
                <Frame x:Name="MaifFrame" Margin="10" NavigationUIVisibility="Hidden" Content="{Binding CurrentView, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>
            <Border BorderBrush="#1A1110" BorderThickness="0,1,0,0"
                        Padding="4">
                <StackPanel Grid.Column="0">
                    <RadioButton GroupName="MainMenue" Style="{StaticResource RadioButton_Style}" Tag="/Resources/Imgs/Overview.png"
                               Content="Overview" FontSize="14" Command="{Binding DashboardCmd}"/>
                    <RadioButton GroupName="MainMenue" Style="{StaticResource RadioButton_Style}" Tag="/Resources/Imgs/Devices.png"
                               Content="Devices" FontSize="14" Command="{Binding DevicesCmd}"/>
                    <RadioButton GroupName="MainMenue" Style="{StaticResource RadioButton_Style}" Tag="/Resources/Imgs/Messages.png"
                               Content="SNMP Alerts" FontSize="14" Command="{Binding SnmpAlerts}"/>
                    <RadioButton GroupName="MainMenue" Style="{StaticResource RadioButton_Style}" Tag="/Resources/Imgs/Analyzing.png"
                               Content="Quick Analyzing" FontSize="14"/>
                    <RadioButton GroupName="MainMenue" Style="{StaticResource RadioButton_Style}" Tag="/Resources/Imgs/DeviceTemplates.png"
                               Content="Device Templates" FontSize="14" Command="{Binding DeviceTemplates}"/>
                    <RadioButton GroupName="MainMenue" Style="{StaticResource RadioButton_Style}" Tag="/Resources/Imgs/Settings.png"
                               Content="Settings" FontSize="14"/>
                </StackPanel>
            </Border>



        </Grid>
    </Grid>
</Window>
