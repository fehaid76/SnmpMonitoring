<UserControl x:Class="snmpMon.Resources.Constrols.Devices.DeviceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.Devices"
             xmlns:co="clr-namespace:snmpMon.Converters"
             mc:Ignorable="d" 
             d:DesignWidth="300">
    <UserControl.Resources>
        <co:DeviceLogoVendorIconConverter x:Key="VendorLogoConverter"/>
    </UserControl.Resources>
    <Grid>
        <Border Background="#292629" CornerRadius="5"
                 BorderThickness="0.5" BorderBrush="#F0F8FF" Margin="10" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Image RenderOptions.BitmapScalingMode="HighQuality"
                           Height="20" Margin="5"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                        <Image.ToolTip>
                            <ToolTip x:Name="toolTip" Style="{StaticResource ToolTip_Style}" Content="Connection status"/>
                        </Image.ToolTip>
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="/Resources/Imgs/AlertImgs/disconnected.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Source" Value="/Resources/Imgs/AlertImgs/connected.png"/>
                                        <Setter Property="ToolTip" Value="Disconnected"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <Image Grid.Column="0" Source="/Resources/Imgs/Router.png" RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,10,0,0" Height="40"/>
                    <TextBlock Grid.Column="1" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Foreground="White"
                               FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource Google_Sans}"/>
                </Grid>
                <Line X1="240" Stroke="White" Height="0.5" StrokeThickness="0.2" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="/Resources/Imgs/ip.png" RenderOptions.BitmapScalingMode="HighQuality" Height="17" Width="17"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3">
                        <Image.ToolTip>
                            <ToolTip Style="{StaticResource ToolTip_Style}" Content="IP Address"/>
                        </Image.ToolTip>
                    </Image>
                    <TextBlock Grid.Column="1" FontSize="14" Foreground="White" FontFamily="{StaticResource Google_Sans}"
                               Text="{Binding IPAddress, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Image Grid.Column="3" Source="/Resources/Imgs/ethernet.png" RenderOptions.BitmapScalingMode="HighQuality" Height="17" Width="17"
                         VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3">
                        <Image.ToolTip>
                            <ToolTip Style="{StaticResource ToolTip_Style}" Content="Ports"/>
                        </Image.ToolTip>
                    </Image>
                    <TextBlock Grid.Column="4" FontSize="14" Foreground="White" FontFamily="{StaticResource Google_Sans}"
                               Text="{Binding PortsCount, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="2" Style="{StaticResource Delete_Button_Style}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Command="{Binding DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding DeleteCommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Grid.Column="1" Style="{StaticResource Go_Button_Style}" Command="{Binding GoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                    <Border CornerRadius="6" SnapsToDevicePixels="True" Margin="10,0,0,0" Grid.Column="0" Background="#F5F5F5"
                            VerticalAlignment="Center" HorizontalAlignment="Left" Width="65" Height="25" Opacity="0.8">
                        <TextBlock Text="{Binding Vendor, UpdateSourceTrigger=PropertyChanged}" FontSize="12" FontFamily="{StaticResource Wafeq_Font}" Foreground="#2A3439" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
