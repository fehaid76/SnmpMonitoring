<UserControl x:Class="snmpMon.Resources.Constrols.BoxesControls.AlertingBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.BoxesControls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" Margin="5"
             xmlns:ctrl="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400">

    <Grid>
        <Border Background="#1B1B1B" CornerRadius="10" Padding="5"
                  Margin="5" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Resources/Imgs/alert_icon.png" RenderOptions.BitmapScalingMode="HighQuality"
                           Height="25" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="System alerts" FontFamily="{StaticResource Exo_2}" FontSize="15" Foreground="White"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5" Grid.Column="1"/>
                </Grid>
                <Line Grid.Row="1" Stroke="White" Opacity="0.5" Stretch="Fill" X1="200" Height="1" Margin="5"/>
                <Border Grid.Row="2" Background="#1F1E1E" SnapsToDevicePixels="True"
                        Padding="5" Margin="5">
                        <ListView ItemsSource="{Binding Alerts, UpdateSourceTrigger=PropertyChanged}"

                                  Margin="2"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.Resources>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource SrollViewer_Style}">
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                            </Style>
                        </ListView.Resources>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                <ctrl:SystemMessage
                                        MessageContent="{Binding AlertMessage}"
                                        ToolTip="{Binding AlertMessage}"
                                        AlertTime="{Binding AlertTime}"
                                        WarningLevelIcon="{Binding WarningLevelIcon}"/>

                            </DataTemplate>
                            </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        </ListView>
                      
                </Border>
            </Grid>  
        </Border>
    </Grid>
</UserControl>
