<UserControl x:Class="snmpMon.Resources.Constrols.LabelControls.UptimeDownstreamMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
             mc:Ignorable="d" 
             d:DesignHeight="50">
    <Grid>
        <Border Background="#1F1E1E" BorderBrush="#3B3939" BorderThickness="1" SnapsToDevicePixels="True"
                Padding="4,2" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#383838" CornerRadius="8" Width="65" BorderThickness="0" SnapsToDevicePixels="True"
                        Padding="3,1" Margin="3,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MessageTime, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource Wafeq_Font}" FontSize="10" Margin="5,3,5,3" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Grid.Column="1" Background="#023e8a" CornerRadius="8" Opacity="0.8" BorderThickness="0" Padding="4,1" Margin="5,0,0,0"
                        VerticalAlignment="Center" Visibility="{Binding DeviceNameVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Text="{Binding DeviceName, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource Google_Sans}" Foreground="White" FontSize="11" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Margin="2"/>
                </Border>
                <TextBlock Grid.Column="2" FontFamily="{StaticResource Google_Sans}" FontSize="12" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="5,2" Text="{Binding MessageContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid> 
        </Border>
    </Grid>
</UserControl>
