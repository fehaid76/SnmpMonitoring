<UserControl x:Class="snmpMon.Resources.Constrols.LabelControls.Cards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
             xmlns:ctrl="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
             xmlns:charts="clr-namespace:snmpMon.Resources.Constrols.Charts"
             xmlns:box="clr-namespace:snmpMon.Resources.Constrols.BoxesControls"
             mc:Ignorable="d" 
             d:DesignHeight="640" d:DesignWidth="855">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>

        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ctrl:StatusLabel Grid.Row="1"
                                      Title="Online / Up Devices" Count="{Binding DevicesCount}"
                                      Image="/Resources/Imgs/Device.png" Width="315" ButtonRefreshVisibility="Visible" RefreshCommand="{Binding RefreshCommand}"/>
                <ctrl:StatusLabel Grid.Row="1"
                                      Title="Average Network Latency" Count="{Binding AverageLatency, StringFormat={}{0:F2}}"
                                      Image="/Resources/Imgs/Network.png" Width="315"/>
                <ctrl:StatusLabel Grid.Row="1"
                                      Title="Active Alerts / Traps" Count="{Binding AlertCount}"
                                      Image="/Resources/Imgs/Alert.png" Width="315"/>

            </StackPanel>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="2">
            <charts:LineChart Grid.Column="0"
                              Height="250"
                              SeriesViews="{Binding SeriesViews2, UpdateSourceTrigger=PropertyChanged}"
                              XAxes="{Binding XAxesList, UpdateSourceTrigger=PropertyChanged}"
                              Title="Average Network Latency"
                              ClearCommand="{Binding ClearCommand}"/>

            <charts:LineChart Grid.Column="1"
                   Height="250"   
                   HighValueVisibility="Visible"
                   HighValue="{Binding TopConsumerDevice, UpdateSourceTrigger=PropertyChanged}"
                   SeriesViews="{Binding InTrafficViews, UpdateSourceTrigger=PropertyChanged}"
                   XAxes="{Binding XAxesList, UpdateSourceTrigger=PropertyChanged}"
                   Title="Inbound/Outbound Traffic"
                   LegendTextPaint="{Binding LegendTextPaint}"
                   LegPosition="Top"
                   ClearCommand="{Binding ClearCommand}"/>


        </UniformGrid>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <box:AlertingBox x:Name="AlertBox" Width="900" Height="300" Grid.Column="0"
                 RouterIP="{Binding DataContext.Device.IPAddress, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 IsDeviceNameVisiable="Visible"/>
            <box:UptimeDownstreamMonitor Grid.Column="1" Height="300" Width="350"/>
        </Grid>

    </Grid>
</UserControl>
