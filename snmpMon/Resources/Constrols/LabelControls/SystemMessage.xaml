<UserControl x:Class="snmpMon.Resources.Constrols.LabelControls.SystemMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="450">
    <Grid>
        <Border Background="#1F1E1E" BorderBrush="#3B3939" BorderThickness="1" SnapsToDevicePixels="True"
                Padding="3" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding WarningLevelIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" RenderOptions.BitmapScalingMode="HighQuality" Height="20" Grid.Column="0"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"/>
                <TextBlock Text="{Binding MessageContent, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.Column="2"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Google_Sans}" FontSize="13"
                           Foreground="White" Margin="5"/>
                <Border Grid.Column="1" CornerRadius="10" Background="#383838"
                        BorderThickness="0" SnapsToDevicePixels="True" Padding="3" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AlertTime, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource Wafeq_Font}" FontSize="13" Margin="5,3,5,3"
                               Foreground="#DEDEDE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid> 
        </Border>
    </Grid>
</UserControl>
