<UserControl x:Class="snmpMon.Resources.Constrols.LabelControls.SystemMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="450">
    <Grid>
        <Border Background="#1F1E1E" BorderBrush="#3B3939" BorderThickness="1" SnapsToDevicePixels="True"
                Padding="4,2" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding WarningLevelIcon, RelativeSource={RelativeSource AncestorType=UserControl}}" RenderOptions.BitmapScalingMode="HighQuality" Height="16" Grid.Column="0"
                        VerticalAlignment="Center" Margin="3,0"/>
                <TextBlock Text="{Binding MessageContent, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.Column="3"
                            VerticalAlignment="Center" FontFamily="{StaticResource Google_Sans}" FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="White" Margin="5,2"/>
                <Border Grid.Column="1" CornerRadius="8" Background="#383838"
                        BorderThickness="0" SnapsToDevicePixels="True" Padding="4,1" Margin="3,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AlertTime, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource Wafeq_Font}" FontSize="10" Margin="5,3,5,3"
                               Foreground="#DEDEDE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="DeviceName" Grid.Column="2" HorizontalAlignment="Left" CornerRadius="8" Background="White" BorderThickness="0" Padding="4,1" Margin="3,0" VerticalAlignment="Center">
                    <TextBlock Text="Cisco Device" FontFamily="{StaticResource Google_Sans}" FontSize="12" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="Black"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
