<UserControl x:Class="snmpMon.Resources.Constrols.LabelControls.Information"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="300">
    <Grid>
        <Border Background="#1B1B1B"  SnapsToDevicePixels="True" Margin="5" Padding="5"
                BorderThickness="5,0.5,0.5,0.5" BorderBrush="#3B3C36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Image, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.Column="0"
                       Height="30" Width="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.Column="1"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" FontSize="13" FontFamily="{StaticResource Wafeq_Font}"
                           Foreground="White" TextWrapping="Wrap"
                           FlowDirection="LeftToRight"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
