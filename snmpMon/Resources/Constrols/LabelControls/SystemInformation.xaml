<UserControl x:Class="snmpMon.Resources.Constrols.LabelControls.SystemInformation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="400">
    <Grid>
        <Border CornerRadius="10" SnapsToDevicePixels="True"
                Padding="5" Margin="5" Background="#1B1B1B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Resources/Imgs/System.png" Grid.Column="0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="3" RenderOptions.BitmapScalingMode="HighQuality" Height="25"/>
                    <TextBlock Text="System Information" FontFamily="{StaticResource Google_Sans}" Foreground="White"
                               FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4" Grid.Column="1"/>
                </Grid>
                <Line Grid.Row="1" Stroke="White" Height="0.9" Opacity="0.5" Stretch="Fill" X1="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,10,0,0">
                        <TextBlock Text="Status:" FontFamily="{StaticResource Google_Sans}" Foreground="White" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Status, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource Google_Sans}" Foreground="White" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10,10,0,0">
                        <TextBlock Text="System name:" FontFamily="{StaticResource Google_Sans}" Foreground="White" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SystemName, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource Google_Sans}" Foreground="White" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="10,10,0,0">
                        <TextBlock Text="Location:" FontFamily="{StaticResource Google_Sans}" Foreground="White" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Location, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource Google_Sans}" Foreground="White" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="10,10,0,10">
                        <TextBlock Text="UP time:" FontFamily="{StaticResource Google_Sans}" Foreground="White" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UpTime, StringFormat={}{0:%d} days {0:%h} hours {0:%m} minutes {0:%s} seconds, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource Google_Sans}" Foreground="#E9D66B" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                </Grid>
            </Grid> 
        </Border>
    </Grid>
</UserControl>
