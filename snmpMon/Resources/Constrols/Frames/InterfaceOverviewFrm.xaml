<UserControl x:Class="snmpMon.Resources.Constrols.Frames.InterfaceOverviewFrm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.Frames"
             xmlns:chart="clr-namespace:snmpMon.Resources.Constrols.Charts"
             mc:Ignorable="d" 
             xmlns:converter ="clr-namespace:snmpMon.Converters"
             d:DesignHeight="760" d:DesignWidth="950" Background="#242124">
    <UserControl.Resources>
        <converter:InterfaceOverviewConverter x:Key="TextConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="15,5,5,5">
                <TextBlock Text="Interface" Foreground="#1E90FF" FontSize="18" FontFamily="{StaticResource Google_Sans}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Grid.Column="0"/>
                <TextBlock Text="{Binding IfDesc, UpdateSourceTrigger=PropertyChanged}" Foreground="LightSeaGreen" FontSize="17" FontFamily="{StaticResource Google_Sans}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
        <Line X1="950" Y1="0" Height="0.5" Stretch="Fill" Grid.Row="1" Stroke="#DFDFDF"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="5" Padding="5" BorderThickness="0" Background="#2A2A2A"
                    SnapsToDevicePixels="True">
                <chart:LineChart Height="250" Title="Interface Traffic monitor" Margin="10"
                                  SeriesViews="{Binding TrafficSpeedsViews, UpdateSourceTrigger=PropertyChanged}"
                                 XAxes="{Binding XAxesList, UpdateSourceTrigger=PropertyChanged}"
                                 LegendTextPaint="{Binding LegendTextPaint}"
                                 LegPosition="Top"
                                 ClearCommand="{Binding ClearCommand}"/>
            </Border>
            <Border Grid.Row="1" Margin="5" Padding="5" BorderThickness="0" Background="#2A2A2A" SnapsToDevicePixels="True">

                    <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" Style="{StaticResource IntTrafficColumnHeader}"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              RowBackground="#232020" HeadersVisibility="Column" HorizontalContentAlignment="Center"
                              RowHeaderWidth="0" CanUserAddRows="False" GridLinesVisibility="None" AutoGenerateColumns="False" Padding="5" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date Time" Width="*"/>
                            <DataGridTextColumn Header="Traffic Total (Volume)" Width="*"/>
                            <DataGridTextColumn Header="Traffic Total (Speed)" Width="*"/>
                            <DataGridTextColumn Header="Traffic In (Volume)" Width="*"/>
                            <DataGridTextColumn Header="Traffic In (Speed)" Width="*"/>
                            <DataGridTextColumn Header="Traffic Out (Volume)" Width="*"/>
                            <DataGridTextColumn Header="Traffic Out (Speed)" Width="*"/>
                        </DataGrid.Columns>


                    </DataGrid>

                    <DataGrid Style="{DynamicResource IntTrafficColumnHeader}" ItemsSource="{Binding InterfaceDetails, UpdateSourceTrigger=PropertyChanged}"
                              RowBackground="#141212" HeadersVisibility="Column" HorizontalContentAlignment="Center" CanUserDeleteRows="False"
                              CanUserSortColumns="False" Height="Auto" VerticalAlignment="Stretch" Grid.Row="1" IsReadOnly="True"
                              RowHeaderWidth="0" CanUserAddRows="False" GridLinesVisibility="None" AutoGenerateColumns="False" Padding="5" >
                            <DataGrid.Columns>
                            <DataGridTextColumn Header="Date Time" Width="*" Binding="{Binding DateTime}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="Silver"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                                <DataGridTextColumn Header="Traffic Total (Volume)" Width="*" Binding="{Binding TrafficTotalVolume, StringFormat='{}{0} KByte'}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{Binding TrafficTotalVolume, Converter={StaticResource TextConverter}}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Traffic Total (Speed)" Width="*" Binding="{Binding TrafficTotalSpeed, StringFormat='{}{0} kbit/s'}"/>
                                <DataGridTextColumn Header="Traffic In (Volume)" Width="*" Binding="{Binding TrafficInVolume, StringFormat='{}{0} KByte'}"/>
                                <DataGridTextColumn Header="Traffic In (Speed)" Width="*" Binding="{Binding TrafficInSpeed, StringFormat='{}{0} kbit/s'}"/>
                                <DataGridTextColumn Header="Traffic Out (Volume)" Width="*" Binding="{Binding TrafficOutVolume, StringFormat='{}{0} KByte'}"/>
                                <DataGridTextColumn Header="Traffic Out (Speed)" Width="*" Binding="{Binding TrafficOutSpeed, StringFormat='{}{0} kbit/s'}"/>
                            </DataGrid.Columns>


                        </DataGrid>

                    </Grid>

            </Border>
        </Grid>
    </Grid>
</UserControl>
