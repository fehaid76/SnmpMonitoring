<UserControl x:Class="snmpMon.Resources.Constrols.Frames.SnmpAlerts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.Frames"
             xmlns:infoCtrl="clr-namespace:snmpMon.Resources.Constrols.LabelControls"
             mc:Ignorable="d" 
             xmlns:converter="clr-namespace:snmpMon.Converters"
             d:DesignHeight="850" d:DesignWidth="980" Background="#242124">
    <UserControl.Resources>
        <converter:AlertSeverityBorderColorConverter x:Key="AlertColorsConverter"/>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="Main_Border" Margin="5" CornerRadius="7" SnapsToDevicePixels="True" Padding="5" BorderThickness="0" Background="#1F1D1D">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <infoCtrl:Information Grid.Row="0" Height="60" Margin="10"
                                      Image="/Resources/Imgs/Information.png"
                                      Title="This section shows historical network alerts. Data is read-only and cannot be modified or deleted."/>

                <UniformGrid Grid.Row="1">
                    <Border CornerRadius="5" Background="#141212" SnapsToDevicePixels="True" Padding="3" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="5" Background="#242124" Margin="5">
                                    <Image Source="/Resources/Imgs/Filter.png" RenderOptions.BitmapScalingMode="HighQuality" Height="15" 
                                       Grid.Column="0" Width="20" Margin="3"/>
                                </Border>

                                <TextBox Height="25" Width="240" Margin="5,5,0,5" Grid.Column="1"
                                         Style="{StaticResource TextBox_Style}" Opacity="0.7"
                                         Tag="Search by IP, Device, or Content..."
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Button Content="Refresh" Style="{StaticResource Button_Modern}" Grid.Column="2" Height="25" Width="110"
                                    Foreground="#FEFEFA" Tag="/Resources/Imgs/Refresh.png" Background="#137BCF" Margin="5" FontSize="13"
                                    FontFamily="{StaticResource Exo_2_Medium}" Command="{Binding RefreshCommand}"/>
                        </Grid>
                    </Border>
                </UniformGrid>
                <UniformGrid Grid.Row="2">
                    <DataGrid ColumnHeaderStyle="{StaticResource DataGridColumnHeader_Style}" RowHeaderStyle="{DynamicResource DataGridRowHeaderStyle2}"
                          Grid.Row="2" ItemsSource="{Binding AlertsView}" RowBackground="Transparent" Background="Transparent" SnapsToDevicePixels="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" RowStyle="{StaticResource DataGridRow_Style}" HeadersVisibility="Column" RowHeaderWidth="0"
                          GridLinesVisibility="None" Padding="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding AlertTime}" Width="auto"/>
                            <DataGridTextColumn Header="Device IP" Binding="{Binding IPAddress }" Width="auto"/>
                            <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="auto" Foreground="#85B09A"/>
                            <DataGridTextColumn Header="Alert Content" Binding="{Binding AlertMessage}" Width="*"/> 
                            <DataGridTemplateColumn Header="Severity">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Background="{Binding AlertLevel, Converter={StaticResource AlertColorsConverter}}"
                                                SnapsToDevicePixels="True" Margin="4" Padding="3" MinWidth="40" Opacity="0.8">
                                            <TextBlock Text="{Binding AlertSeverity}" FontFamily="{StaticResource Google_Sans}" Foreground="#222222"
                                                       FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                        </DataGrid.Columns>

                    </DataGrid>

                </UniformGrid>
            </Grid>
        </Border>    
    </Grid>
</UserControl>
