<UserControl x:Class="snmpMon.Resources.Constrols.Frames.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.Frames"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="980" Background="#242124">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Settings" FontSize="15" FontFamily="{StaticResource Google_Sans}" Foreground="White"
                   Margin="10,7,0,3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Border Background="Transparent" Height="10.8" BorderBrush="#edede9" BorderThickness="0,0.5,0,0" Margin="5" Grid.Row="1"/>

        <TabControl Grid.Row="2" Style="{StaticResource TabControl_Style}" Background="Transparent" BorderThickness="0">
            <TabItem Header="Devices" Style="{StaticResource TabItem_Style}">
                <Border Background="Silver"/>
            </TabItem>
            <TabItem Header="Polling Intervals" Style="{StaticResource TabItem_Style}">
                <Border Background="Black"/>
            </TabItem>
            <TabItem Header="Alerts Settings" Style="{StaticResource TabItem_Style}">
                <Border Background="DarkSlateBlue"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
