<UserControl x:Class="snmpMon.Resources.Constrols.Charts.Gauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.Charts"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="270">
    <Grid>
        <Grid>
            <Border CornerRadius="5" SnapsToDevicePixels="True"
                Margin="5" BorderBrush="#F0F8FF" BorderThickness="0.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Image Source="/Resources/Imgs/Title.png" Grid.Column="0" Margin="5"
                           RenderOptions.BitmapScalingMode="HighQuality" Height="20" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontFamily="{StaticResource Exo_2_Medium}" Foreground="#F0F8FF"
                               FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                    <Line Grid.Row="1" Stroke="#F0F8FF" X1="0" X2="1" Stretch="Fill" Height="0.4"/>
                    <lvc:Gauge x:Name="gauge" Grid.Row="2"
                               Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               From="{Binding FromValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               To="{Binding ToValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="White"
                               FontSize="15"
                               GaugeBackground="#F0F8FF"
                               GaugeActiveFill="#568203"
                               Margin="5">
                    </lvc:Gauge>
                </Grid>

            </Border>
        </Grid>

    </Grid>
</UserControl>
