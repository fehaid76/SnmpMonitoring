<UserControl x:Class="snmpMon.Resources.Constrols.Charts.LineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.Charts"
             mc:Ignorable="d" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             d:DesignHeight="250" d:DesignWidth="500">
    <Grid>
        <Border CornerRadius="5" SnapsToDevicePixels="True"
                Margin="5" BorderBrush="#F0F8FF" BorderThickness="0.5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="2" SnapsToDevicePixels="True" CornerRadius="5" Background="#212529" Margin="3,3,10,3" HorizontalAlignment="Center"
                            Padding="5" Visibility="{Binding HighValueVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Resources/Imgs/Top.png" Grid.Column="0" RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,5,0" Height="15"
                                   ToolTip="Top Traffic Consumer"/>
                            <TextBlock Text="{Binding HighValue, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.Column="1" FontFamily="{StaticResource Google_Sans}" Foreground="#fefae0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="3" Height="20"   HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,5,8,5" Style="{StaticResource Clear_Button}" Visibility="{Binding ClearButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Command="{Binding ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Clear" Tag="/Resources/Imgs/Clear.png"/>
                    <Image Source="/Resources/Imgs/Title.png" Grid.Column="0" Margin="5"
                           RenderOptions.BitmapScalingMode="HighQuality" Height="20" HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" FontFamily="{StaticResource Exo_2_Medium}" Foreground="#F0F8FF"
                               FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
                <Line Grid.Row="1" Stroke="#F0F8FF" X1="0" X2="1" Stretch="Fill" Height="0.4"/>
                <lvc:CartesianChart Grid.Row="2" Background="Transparent"
                                    Series="{Binding SeriesViews, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    XAxes="{Binding XAxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    YAxes="{Binding YAxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    LegendTextPaint="{Binding LegendTextPaint, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    LegendPosition="{Binding LegPosition, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    LegendTextSize="13"
                                    ZoomMode="Both"
                                    />
            </Grid>

        </Border>

    </Grid>
</UserControl>
