<UserControl x:Class="snmpMon.Resources.Constrols.InputControls.TextInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.InputControls"
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="370">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="15" RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,5,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{StaticResource Exo_2}" FontSize="15" Foreground="White"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>
        <TextBox Grid.Row="1" Height="27" Width="350" Style="{StaticResource TextBox_Style}" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                 FontFamily="{StaticResource Exo_2_Medium}" IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Foreground="{Binding TextInputColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Focusable="{Binding FoucableTextInput, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Margin="0,5,0,0"/>
    </Grid>
</UserControl>
