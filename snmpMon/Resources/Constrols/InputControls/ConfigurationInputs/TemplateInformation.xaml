<UserControl x:Class="snmpMon.Resources.Constrols.InputControls.ConfigurationInputs.TemplateInformation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:snmpMon.Resources.Constrols.InputControls.ConfigurationInputs"
             mc:Ignorable="d" 
             xmlns:inputCtrl="clr-namespace:snmpMon.Resources.Constrols.InputControls"
             d:DesignHeight="450" d:DesignWidth="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="7" SnapsToDevicePixels="True" Padding="5" Margin="5" Background="#1F1D1D">
            <TextBlock Text="Template Information" FontFamily="{StaticResource Google_Sans}" FontSize="15" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="White"/>
        </Border>
        <inputCtrl:TextInput Grid.Row="1" Title="Template Name" Icon="/Resources/Imgs/Hashtag.png" Text="{Binding TemplateName, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                             IsReadOnly="{Binding TemplateNameIsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <inputCtrl:TextInput Grid.Row="2" Title="Vendor" Icon="/Resources/Imgs/Hashtag.png" Text="{Binding Vendor, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
        <Border Grid.Row="3" Background="White" Opacity="0.4" Height="0.6" Margin="2,10,2,4"/>
        <TextBlock Text="OIDs Details" FontFamily="{StaticResource Exo_2}" Foreground="White" Grid.Row="4" HorizontalAlignment="Left"
                   VerticalAlignment="Center" Margin="5,0,0,0" Opacity="0.7"/>
        <Grid Grid.Row="5" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <inputCtrl:TextInput Grid.Row="0" Title="Memory Usage" Text="{Binding MemoryUsage, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>

            <inputCtrl:TextInput Grid.Row="2" Title="CPU Usage" Text="{Binding CPUUsage, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
            <inputCtrl:TextInput Grid.Row="3" Title="Device Temperature" Text="{Binding DeviceTemperature, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
        </Grid>

        <Button Grid.Row="6" Style="{StaticResource Button_Modern}" Content="Confirm" Height="30" Width="100" Background="Green"  Tag="/Resources/Imgs/Add.png"
                Command="{Binding ConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding CommandPar, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>
