<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Go_Button_Style" TargetType="Button">
        <Setter Property="BorderThickness" Value="10"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="Background" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    
                    <Grid>

                        <Border x:Name="border" CornerRadius="5" 
                                Background="Transparent" BorderBrush="White"
                                BorderThickness="0.3" SnapsToDevicePixels="True"
                                Margin="5" HorizontalAlignment="Center">
                            <Grid>
                                <Image x:Name="ImageMonitoring" Grid.Column="2" Source="/Resources/Imgs/Monitoring.png"
                               RenderOptions.BitmapScalingMode="HighQuality" Height="20" Margin="3"/>
                                <ContentPresenter Grid.Column="0"/>
                            </Grid>
                        </Border>

                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ImageMonitoring" Property="Source" Value="/Resources/Imgs/Monitoring_Green.png"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>