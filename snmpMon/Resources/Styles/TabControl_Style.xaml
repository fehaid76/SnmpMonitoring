<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="TabControl_Style" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="7" Margin="5,5,5,1" Background="#242124" SnapsToDevicePixels="True" Padding="5">
                            <TabPanel IsItemsHost="True"/>
                        </Border>

                        <Border Grid.Row="1" CornerRadius="7" Margin="5,1,5,5" Background="#242124" SnapsToDevicePixels="True" Padding="5">
                            <ContentPresenter
                                  ContentSource="SelectedContent" 
                                  Margin="0,10,0,0"/>
                        </Border>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>